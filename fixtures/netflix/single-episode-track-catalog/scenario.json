{
  "schemaVersion": 1,
  "name": "single-episode-track-catalog",
  "service": "netflix",
  "source": {
    "captureToolVersion": "1.0.0",
    "scriptVersion": "1.0.13",
    "sanitization": {"version": 1, "redactions": 21, "warnings": []}
  },
  "page": {"host": "www.netflix.com", "path": "/watch/TOKEN_1"},
  "capture": {
    "startedAt": "2026-01-01T00:00:00.000Z",
    "durationMs": 1200,
    "truncated": false,
    "limits": {
      "maxEvents": 3000,
      "maxSnapshots": 500,
      "maxArtifacts": 200,
      "maxArtifactBytes": 1048576,
      "maxCaptureBytes": 20971520,
      "maxStringBytes": 4096,
      "maxArrayItems": 200,
      "maxObjectKeys": 200,
      "maxDepth": 12
    }
  },
  "replay": {"driver": "netflix-subtitle-catalog-v1", "input": "ARTIFACT_1"},
  "events": [
    {
      "seq": 1,
      "t": 0,
      "type": "session.started",
      "session": "SESSION_1",
      "data": {"reason": "navigation"}
    },
    {
      "seq": 2,
      "t": 900,
      "type": "download.selection",
      "session": "SESSION_1",
      "data": {"artifact": "ARTIFACT_1", "selectedTrackCount": 7, "episodeTag": "S01E05"}
    }
  ],
  "snapshots": [
    {
      "seq": 3,
      "t": 1000,
      "kind": "filename.resolved",
      "session": "SESSION_1",
      "data": {"filename": "SHOW_001.S01E05"}
    }
  ],
  "artifacts": {
    "ARTIFACT_1": {
      "kind": "track-catalog",
      "format": "json",
      "byteLength": 2242,
      "input": "input/artifact-001.json"
    }
  }
}
